---
import BaseLayout from '../components/layout/BaseLayout.astro';
import SectionDivider from '../components/ui/SectionDivider.astro';
---

<BaseLayout
  title="Home"
  description="Expedition Oz — Luxury sailing charters through the Ningaloo, Western Australia. Orcas, humpbacks, manta rays, whale sharks. Two black steel sailboats. The ocean, up close."
>

  <!-- ─── Hero ─── -->
  <section
    id="hero"
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background: var(--color-abyss);"
  >
    <!-- Background radial glow -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 80% 60% at 50% 0%, color-mix(in srgb, var(--color-ocean) 25%, transparent), transparent 70%);"
    ></div>

    <!-- Vertical accent line -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-px"
      style="height: 120px; background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--color-gold) 50%, transparent));"
    ></div>

    <div class="relative z-10 text-center px-6 max-w-5xl mx-auto pt-20">
      <!-- Location label -->
      <p
        class="font-body inline-block mb-8"
        style="color: var(--color-slate); font-size: var(--text-label); letter-spacing: 0.25em; text-transform: uppercase;"
      >
        Ningaloo &nbsp;·&nbsp; Western Australia
      </p>

      <!-- Main headline -->
      <h1
        class="font-display leading-none mb-8"
        style="font-size: var(--text-hero); color: var(--color-sand);"
      >
        Sail Further.<br />
        <em style="color: var(--color-gold); font-style: italic;">Dive Deeper.</em>
      </h1>

      <p
        class="font-body mx-auto mb-12"
        style="font-size: 1.25rem; color: var(--color-slate); max-width: 44rem; line-height: 1.8;"
      >
        Two black steel sailboats. Six to twelve souls. The untouched reefs of the Ningaloo
        coast, experienced the way it was always meant to be — from the water.
      </p>

      <!-- CTAs -->
      <div class="flex gap-4 justify-center flex-wrap">
        <a
          href="/expeditions"
          class="font-body px-8 py-4 transition-colors duration-300"
          style="background: var(--color-gold); color: var(--color-abyss); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase;"
        >
          Discover Expeditions
        </a>
        <a
          href="/our-story"
          class="font-body px-8 py-4 transition-colors duration-300"
          style="border: 1px solid var(--color-ocean); color: var(--color-foam); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase;"
        >
          Our Story
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
      <span
        class="font-body"
        style="color: var(--color-slate); font-size: 0.6875rem; letter-spacing: 0.3em; text-transform: uppercase;"
      >
        Scroll
      </span>
      <div
        class="w-px"
        style="height: 48px; background: linear-gradient(to bottom, var(--color-slate), transparent);"
      ></div>
    </div>
  </section>

  <SectionDivider fromColor="var(--color-abyss)" toColor="var(--color-deep)" />

  <!-- ─── Brand statement ─── -->
  <section class="section-py px-6" style="background: var(--color-deep);">
    <div class="container-site text-center" style="max-width: 56rem; margin-left: auto; margin-right: auto;">
      <p
        class="font-body mb-8"
        style="color: var(--color-gold); font-size: var(--text-label); letter-spacing: 0.2em; text-transform: uppercase;"
      >
        The Story
      </p>
      <h2
        class="font-display leading-tight mb-8"
        style="font-size: var(--text-display); color: var(--color-foam);"
      >
        Born in the South Pacific.<br />
        <em style="color: var(--color-gold); font-style: italic;">At home in the Ningaloo.</em>
      </h2>
      <p
        class="font-body mx-auto"
        style="color: var(--color-slate); font-size: 1.1875rem; line-height: 1.85; max-width: 38rem;"
      >
        For over a decade, our sailboats carried adventurers island to island across South Asia.
        Now we bring that same soul — that same deep respect for the ocean and everything within it —
        to the wild, remote coastline of Western Australia.
      </p>
      <a
        href="/our-story"
        class="inline-block mt-10 font-body"
        style="color: var(--color-horizon); font-size: var(--text-label); letter-spacing: 0.15em; text-transform: uppercase; border-bottom: 1px solid color-mix(in srgb, var(--color-horizon) 40%, transparent); padding-bottom: 3px;"
      >
        Read the full story →
      </a>
    </div>
  </section>

  <SectionDivider fromColor="var(--color-deep)" toColor="var(--color-ocean)" flip={true} />

  <!-- ─── Fleet preview ─── -->
  <section class="section-py px-6" style="background: var(--color-ocean);">
    <div class="container-site">
      <div class="text-center mb-16">
        <p
          class="font-body mb-4"
          style="color: var(--color-gold); font-size: var(--text-label); letter-spacing: 0.2em; text-transform: uppercase;"
        >
          The Fleet
        </p>
        <h2
          class="font-display"
          style="font-size: var(--text-display); color: var(--color-foam);"
        >
          Two Ships. One Soul.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Sylfia -->
        <div
          style="background: color-mix(in srgb, var(--color-abyss) 60%, transparent); border: 1px solid color-mix(in srgb, var(--color-horizon) 20%, transparent);"
        >
          <div
            class="aspect-[4/3] flex items-end p-8"
            style="background: linear-gradient(135deg, var(--color-deep), var(--color-abyss));"
          >
            <div>
              <p
                class="font-body mb-2"
                style="color: var(--color-gold); font-size: var(--text-label); letter-spacing: 0.2em; text-transform: uppercase;"
              >
                75 ft · 12 passengers · 3-day expeditions
              </p>
              <h3
                class="font-display"
                style="font-size: 3rem; color: var(--color-foam); letter-spacing: 0.05em; line-height: 1;"
              >
                Sylfia
              </h3>
            </div>
          </div>
          <div class="p-8">
            <p class="font-body" style="color: var(--color-slate); line-height: 1.8; font-size: 0.9375rem;">
              The original. Her black steel hull and rebar mast cut a silhouette unlike anything
              on the water. Shorter expeditions, bigger encounters — orcas, humpbacks, and
              the kind of diving that stays with you.
            </p>
            <a
              href="/fleet/sylfia"
              class="inline-block mt-6 font-body"
              style="color: var(--color-horizon); font-size: var(--text-label); letter-spacing: 0.15em; text-transform: uppercase; border-bottom: 1px solid color-mix(in srgb, var(--color-horizon) 40%, transparent); padding-bottom: 3px;"
            >
              Meet Sylfia →
            </a>
          </div>
        </div>

        <!-- Millennium -->
        <div
          style="background: color-mix(in srgb, var(--color-abyss) 60%, transparent); border: 1px solid color-mix(in srgb, var(--color-horizon) 20%, transparent);"
        >
          <div
            class="aspect-[4/3] flex items-end p-8"
            style="background: linear-gradient(135deg, var(--color-deep), var(--color-abyss));"
          >
            <div>
              <p
                class="font-body mb-2"
                style="color: var(--color-gold); font-size: var(--text-label); letter-spacing: 0.2em; text-transform: uppercase;"
              >
                75 ft · 8 passengers · 8–10 day voyages
              </p>
              <h3
                class="font-display"
                style="font-size: 3rem; color: var(--color-foam); letter-spacing: 0.05em; line-height: 1;"
              >
                Millennium
              </h3>
            </div>
          </div>
          <div class="p-8">
            <p class="font-body" style="color: var(--color-slate); line-height: 1.8; font-size: 0.9375rem;">
              The newest addition. Beamier, more spacious, built for the long voyage.
              Eight passengers. Eight days or more in the Ningaloo's most remote anchorages,
              far from anything resembling ordinary.
            </p>
            <a
              href="/fleet/millennium"
              class="inline-block mt-6 font-body"
              style="color: var(--color-horizon); font-size: var(--text-label); letter-spacing: 0.15em; text-transform: uppercase; border-bottom: 1px solid color-mix(in srgb, var(--color-horizon) 40%, transparent); padding-bottom: 3px;"
            >
              Meet Millennium →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider fromColor="var(--color-ocean)" toColor="var(--color-abyss)" />

  <!-- ─── Placeholder / CTA ─── -->
  <section class="section-py px-6" style="background: var(--color-abyss);">
    <div class="container-site text-center" style="max-width: 48rem; margin-left: auto; margin-right: auto;">
      <p
        class="font-body mb-6"
        style="color: var(--color-slate); font-size: var(--text-label); letter-spacing: 0.2em; text-transform: uppercase;"
      >
        Coming soon
      </p>
      <h2
        class="font-display mb-8"
        style="font-size: var(--text-title); color: var(--color-foam);"
      >
        Expeditions · The Ningaloo · Gallery · Journal
      </h2>
      <p class="font-body mb-10" style="color: var(--color-slate); font-size: 0.9375rem;">
        The full site is on its way. Register your interest and we'll reach out when expeditions open for booking.
      </p>
      <a
        href="/contact"
        class="font-body px-8 py-4 transition-colors duration-300"
        style="background: var(--color-gold); color: var(--color-abyss); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase;"
      >
        Register Your Interest
      </a>
    </div>
  </section>

</BaseLayout>
