---
interface Props {
  fromColor?: string;
  toColor?: string;
  flip?: boolean;
  height?: number;
}

const {
  fromColor = 'var(--color-abyss)',
  toColor = 'var(--color-deep)',
  flip = false,
  height = 80,
} = Astro.props;
---

<div
  class="w-full overflow-hidden"
  style={`height: ${height}px; background: ${fromColor}; ${flip ? 'transform: rotate(180deg);' : ''}`}
>
  <svg
    viewBox="0 0 1440 80"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="none"
    class="w-full h-full"
    aria-hidden="true"
  >
    <path
      d="M0,40 C180,80 360,0 540,40 C720,80 900,0 1080,40 C1260,80 1440,20 1440,40 L1440,80 L0,80 Z"
      fill={toColor}
    />
  </svg>
</div>
